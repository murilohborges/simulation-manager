{
  "name": "SimulationManager",
  "image": "mcr.microsoft.com/devcontainers/dotnet:7.0",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "forwardPorts": [5000, 5001, 3306],
  "portsAttributes": {
    "5000": {
      "label": "API HTTP",
      "onAutoForward": "notify"
    },
    "5001": {
      "label": "API HTTPS",
      "onAutoForward": "notify"
    },
    "3306": {
      "label": "MySQL",
      "onAutoForward": "notify"
    }
  },
  "postCreateCommand": "cd SimulationManager && dotnet restore && dotnet tool install -g dotnet-ef",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-dotnettools.csharp",
        "ms-dotnettools.vscode-dotnet-runtime",
        "ms-mssql.mssql"
      ]
    }
  }
}
